# GrokForge — copy to .env and fill locally. Never commit .env.

# HTTP (default random-ish port)
GROKFORGE_HTTP_ADDR=:17890

# PostgreSQL (use existing instance or compose service)
DATABASE_URL=postgres://grokforge:grokforge@127.0.0.1:5432/grokforge?sslmode=disable

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# At-rest encryption for credentials (long random string)
GROKFORGE_MASTER_KEY=

# YYDS Mail API key (AC-...). Keep only in .env
GROKFORGE_YYDS_API_KEY=
# Optional fixed domain; empty = pick from GET /v1/domains
GROKFORGE_YYDS_DOMAIN=

# Admin bootstrap (setup wizard still forces password reset)
# GROKFORGE_ADMIN_USERNAME=admin
