# GrokForge — copy to .env and fill locally. Never commit .env.
# Public repo: keep this file empty/fake placeholders only.

GROKFORGE_HTTP_ADDR=:17890

# Lightweight local profile: Redis optional (management plane works without it).
# Omit or use prod/empty for production — Redis URL is then required.
GROKFORGE_ENV=dev

# PostgreSQL (required). Prefer an existing instance you already run.
# Optional sandbox compose maps 127.0.0.1:25432 — see docker-compose.yml.
DATABASE_URL=postgres://grokforge:grokforge@127.0.0.1:25432/grokforge?sslmode=disable

# Redis (optional in GROKFORGE_ENV=dev). Without it: no job enqueue/workers.
# REDIS_URL=redis://127.0.0.1:26379/0

# At-rest encryption master key (long random). Required for credential crypto.
GROKFORGE_MASTER_KEY=

# JWT signing secret (>=16 chars). Falls back to MASTER_KEY if empty.
GROKFORGE_JWT_SECRET=

# YYDS Mail API key — leave empty in git; set only in local .env
GROKFORGE_YYDS_API_KEY=
GROKFORGE_YYDS_DOMAIN=

# Cloak free binary path (optional). DRY_RUN=1 simulates register without browser.
# GROKFORGE_CLOAK_BIN=
# GROKFORGE_CLOAK_DRY_RUN=1
